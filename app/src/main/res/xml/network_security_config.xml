<?xml version="1.0" encoding="utf-8"?>
<!-- Le pin-set du serveur de règles (spec §5) arrive avec les mises à jour signées (J5), quand les vraies clés existent. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
