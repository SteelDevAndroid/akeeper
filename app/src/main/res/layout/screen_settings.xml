<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Widget.AKeeper.SectionTitle"
                android:text="@string/settings_section_protection" />

            <LinearLayout
                android:id="@+id/settings_protection"
                style="@style/Widget.AKeeper.SettingsGroup"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_rules_update"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_rules_update" />
            </LinearLayout>

            <TextView
                style="@style/Widget.AKeeper.SectionTitle"
                android:text="@string/settings_section_reliability" />

            <LinearLayout
                android:id="@+id/settings_reliability"
                style="@style/Widget.AKeeper.SettingsGroup"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.AKeeper.SectionTitle"
                android:text="@string/settings_section_network" />

            <LinearLayout
                android:id="@+id/settings_network"
                style="@style/Widget.AKeeper.SettingsGroup"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.AKeeper.SectionTitle"
                android:text="@string/settings_section_privacy" />

            <LinearLayout
                android:id="@+id/settings_privacy"
                style="@style/Widget.AKeeper.SettingsGroup"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.AKeeper.SectionTitle"
                android:text="@string/settings_section_about" />

            <LinearLayout
                android:id="@+id/settings_about"
                style="@style/Widget.AKeeper.SettingsGroup"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
